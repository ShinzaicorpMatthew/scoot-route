{
  "priority": [
    { "if": "true", "multiply_by": "bike_priority" },
    { "if": "!bike_access", "multiply_by": "0" },
    { "if": "bike_road_access == PRIVATE || bike_road_access == NO", "multiply_by": "0" },
    { "if": "road_class == MOTORWAY || road_class == TRUNK || road_class == STEPS", "multiply_by": "0" },
    { "if": "road_environment == FERRY", "multiply_by": "0" },
    { "if": "mtb_rating > 1", "multiply_by": "0" },
    { "if": "track_type == GRADE4 || track_type == GRADE5", "multiply_by": "0.05" },
    { "if": "get_off_bike", "multiply_by": "0.15" },
    { "if": "max_speed > 50 && road_class != CYCLEWAY && bike_network == MISSING", "multiply_by": "0.05" }
  ],
  "speed": [
    { "if": "true", "limit_to": "25" },
    { "if": "get_off_bike", "limit_to": "6" },
    { "if": "surface == COBBLESTONE", "limit_to": "14" },
    { "else_if": "surface == UNPAVED || surface == GRAVEL || surface == FINE_GRAVEL || surface == GROUND || surface == DIRT || surface == GRASS || surface == SAND || surface == COMPACTED", "limit_to": "12" },
    { "if": "average_slope >= 10", "multiply_by": "0.55" },
    { "else_if": "average_slope >= 6", "multiply_by": "0.75" },
    { "else_if": "average_slope >= 3", "multiply_by": "0.9" },
    { "if": "average_slope <= -10", "limit_to": "15" },
    { "else_if": "average_slope <= -6", "limit_to": "20" }
  ],
  "distance_influence": 70
}
