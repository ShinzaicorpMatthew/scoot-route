# Copiez ce fichier en .env puis renseignez les valeurs.

# Jeton de modération des signalements (générez-le : openssl rand -hex 32). OBLIGATOIRE en production.
ADMIN_TOKEN=

# Jeton anti-abus envoyé par l'app (en-tête X-Client-Token). Ce n'est PAS un secret
# (il est embarqué dans l'app) : il filtre seulement les appels anonymes. Laisser vide en dev.
CLIENT_TOKEN=

# Chantiers perturbants de la Métropole de Lyon (GeoJSON, Licence Ouverte 2.0).
# Mettre une chaîne vide pour désactiver.
WORKS_GEOJSON_URL=https://www.data.gouv.fr/api/1/datasets/r/942ada51-f753-486d-8502-98c058313147

# Altitude précise IGN RGE ALTI (gratuit, sans clé, 5 req/s). false = SRTM uniquement.
IGN_ELEVATION=true

# Zone couverte (minLon,minLat,maxLon,maxLat) — doit correspondre à l'extrait OSM
COVERAGE_BBOX=4.65,45.55,5.10,45.95

RATE_LIMIT_PER_MIN=60
